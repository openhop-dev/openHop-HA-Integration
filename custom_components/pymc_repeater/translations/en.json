{
  "config": {
    "step": {
      "user": {
        "title": "Connect to openHop Repeater",
        "description": "Enter the repeater connection details. Home Assistant will log in once, create a dedicated API token, and then store only that token.",
        "data": {
          "host": "Repeater IP address or hostname",
          "port": "HTTP API port",
          "password": "Admin password"
        }
      },
      "reauth_confirm": {
        "title": "Reconnect to openHop Repeater",
        "description": "The saved API token is no longer valid. Enter the current admin password to create a new token.",
        "data": {
          "password": "Admin password"
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect to the repeater",
      "invalid_auth": "Login failed or the API token could not be created",
      "api_error": "The repeater API returned an unexpected error",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This repeater is already configured",
      "reauth_successful": "Reauthentication completed"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "openHop Repeater options",
        "description": "Adjust display units and how often the integration refreshes data from the Repeater API.",
        "data": {
          "data_size_unit": "Data size display unit",
          "uptime_unit": "System uptime display unit",
          "scan_interval": "Integration refresh interval (seconds)",
          "radio_id_aliases": "Radio ID aliases (JSON)"
        },
        "data_description": {
          "radio_id_aliases": "Map renamed runtime radio IDs to their previous Home Assistant IDs using a JSON object, for example source local mapped to target radio0. Confirm that each pair is the same physical radio. IDs are case-sensitive and are not device names. Use an empty JSON object to clear aliases. IDs must be nonempty strings without whitespace. Targets must be unique; chains, cycles, and simultaneous source/target runtime IDs are not allowed. A target may return on its own. Saving reloads the integration. See the operational monitoring documentation for JSON examples and radio retirement behavior."
        }
      }
    },
    "error": {
      "invalid_radio_aliases": "Enter a JSON object mapping runtime IDs to previous Home Assistant IDs. Use unique nonempty strings without whitespace, no duplicate keys or targets, and no chains, cycles, or targets already used by runtime radios. Use {} to clear aliases."
    }
  },
